# Mnemosyne-Cortex .gitignore

# Personal notes
personal/

# ChromaCore runtime databases
*.db
*.db-shm
*.db-wal

# KD-Tree binary (downloaded at runtime via bootstrap)
chromacore/kdtree_cielab.bin

# Memory storage (user data)
mnemosyne/adapters/claude-desktop/membloks/
skills/meridian-glyph/membloks/

# Logs
*.jsonl

# Skill session state (per-user)
skills/meridian-glyph/workflow.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Node / Bun
node_modules/
bun.lockb

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Secrets
.env
.env.*
config.local.json
